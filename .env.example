# ── AWS / Bedrock ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# ── Alpaca (paper trading by default) ─────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Switch to https://api.alpaca.markets for live — requires $500 funded account

# ── Twitter / X API ───────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# ── Twilio SMS ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx   # your Twilio number
TWILIO_TO_NUMBER=+1xxxxxxxxxx     # your personal number

# SMS behavior
SMS_KILL_SWITCH=false             # set to true to silence all SMS
SMS_RATE_LIMIT_PER_HOUR=10        # max texts per hour (circuit breaker at 3 failures)
SMS_MIN_PRIORITY=high             # minimum priority to send: high | critical

# ── Approval & notifications ───────────────────────────────────────────────────
APPROVAL_MODE=file                # file | slack | email
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
